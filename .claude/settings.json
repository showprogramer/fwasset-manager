{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run ruff *)",
      "Bash(uv run mypy*)",
      "Bash(uv run python -m pytest*)",
      "Bash(uv sync *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Read(./config.toml)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./massagechairproject.md)",
      "Read(./specs/project-overview.md)",
      "Read(./**/*.xlsx)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_check.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
